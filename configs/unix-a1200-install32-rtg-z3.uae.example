; Minimal Unix A1200 boot example with Zorro III RTG RAM autoconfig.
; Copy this file and replace the two paths below with local files.
; This is currently useful for host-port smoke testing, not yet a complete
; Picasso96 guest display setup.

kickstart_rom_file=/path/to/A1200.47.115.rom
floppy0=/path/to/Install3.2.adf
nr_floppies=1

chipset=aga
chipset_compatible=A1200
cpu_model=68020
cpu_24bit_addressing=false
chipmem_size=4
cachesize=0

sound_output=normal

gfxcard_size=16
gfxcard_type=ZorroIII
